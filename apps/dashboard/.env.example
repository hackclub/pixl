# Same Supabase project the game server uses
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key

# AES-256-GCM key for decrypting birthday/mailing-address PII (lib/crypto.ts).
# Must match apps/server's PII_ENCRYPTION_KEY exactly.
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Hack Club Auth (https://auth.hackclub.com):
#  - Create an OAuth app at https://auth.hackclub.com/apps
#  - Redirect URI: <BASE_URL>/api/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Slack bot token (for API calls like DMs, avatars, etc.):
#  - https://api.slack.com/apps -> OAuth & Permissions -> Bot User OAuth Token
#  - Bot Token Scopes: chat:write, im:write, channels:history, channels:read
SLACK_BOT_TOKEN=xoxb-...

# Slack help channel ID (where tickets are posted)
SLACK_HELP_CHANNEL=

# Comma-separated Slack member IDs of the permanent super admins (e.g.
# U0123ABC,U0456DEF). Super admins hold every permission and are the only role
# that can grant permissions or promote another super admin. These ones can't be
# demoted from the dashboard , that's the lockout escape hatch. Everyone else is
# promoted from the Admins page into the `super_admins` table.
ADMIN_SLACK_IDS=

# Comma-separated Slack member IDs allowed to do the FINAL (second) review pass.
# Only these reviewers can approve and credit pixels. If left empty, only owners
# (ADMIN_SLACK_IDS) qualify.
SECOND_PASS_SLACK_IDS=

# Player-facing DMs (warns, bans, shipping tracking, notices) are sent directly
# from the dashboard's Slack bot (SLACK_BOT_TOKEN) by default , no extra service
# needed. To route them through Pixorpheus's DM API instead, set BOTH of these:
# EXTERNAL_DM_URL must be your Pixorpheus dashboard.js URL (…/api/external/dm) and
# EXTERNAL_API_KEY must match the x-api-key configured there. Leave blank for direct.
EXTERNAL_DM_URL=
EXTERNAL_API_KEY=

# Resolving a ticket from the dashboard: routes through Pixorpheus's live bot
# (index.js, e.g. https://pixo.pixl.rsvp) instead of the dashboard's own
# narrowly-scoped Slack app. EXTERNAL_TICKETS_URL must be that bot's base URL
# + /api/external/tickets, same EXTERNAL_API_KEY as above. Leave blank to fall
# back to resolving directly from the dashboard's own bot.
EXTERNAL_TICKETS_URL=

# Email fallback (Resend) , used when a player has no slack_id or the DM fails.
# Leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM=Pixl <team@pixl.rsvp>

# Long random string for signing session cookies
SESSION_SECRET=

# Where this dashboard runs (used for the Hack Club Auth redirect)
BASE_URL=http://localhost:4900

# Live game server admin API (Online tab + kick). ADMIN_API_KEY must match the
# server's env. Leave empty to disable the Online tab's live view.
PIXL_SERVER_URL=
ADMIN_API_KEY=

# Daily review-queue Slack alert (vercel.json cron). Channel ID the dashboard
# bot is invited to; leave empty to disable.
REVIEW_ALERT_CHANNEL=

# REQUIRED to use the queue-health cron endpoint (app/api/cron/queue-health) -
# it fails closed (500) if this is unset, rather than allowing unauthenticated
# access. Must match the "Authorization: Bearer <CRON_SECRET>" header the cron
# caller (vercel.json) sends. Generate with: openssl rand -hex 32
CRON_SECRET=

# Joe fraud review (the second review pass). Unset JOE_EVENT_ID or JOE_API_KEY
# to bypass the fraud pass entirely: first pass then goes straight to the final
# human pass, as it did before Joe existed.
JOE_API_BASE=https://joe.fraud.hackclub.com/api/v1/ysws
JOE_EVENT_ID=pixl
JOE_API_KEY=
JOE_WEBHOOK_SECRET=
# One-time per environment, once /api/joe/outcome is deployed:
#   curl -X PATCH "$JOE_API_BASE/events/$JOE_EVENT_ID" \
#     -H "Authorization: Bearer $JOE_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"outcomeWebhookUrl":"https://dash.pixl.hackclub.com/api/joe/outcome/<JOE_WEBHOOK_SECRET>"}'

# GitHub PAT used when fetching a project's commit history (lib/github.ts,
# review queue's Commits tab). Optional , without it those calls run
# unauthenticated and hit GitHub's 60/hr rate limit fast. A fine-grained token
# scoped to "Public Repositories (read-only)" is enough , no extra permissions
# needed since it only reads public commit data:
#  - https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Airtable PAT for the intermediate "YSWS Project Submission" staging base
# (app80yzut0bdMNdHJ) - reviewers push approved projects here by hand from a
# project's page; a teammate then manually forwards each record into Hack
# Club's real Unified YSWS database from inside Airtable itself. Needs
# data.records:read/write + schema.bases:read scope, access limited to just
# that one base:
#  - https://airtable.com/create/tokens
AIRTABLE_PIXL_YSWS_UNIFIED_TOKEN=