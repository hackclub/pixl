{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/docs/:slug", "destination": "/docs/:slug/" },
    { "source": "/shop/item", "destination": "/api/shop-item-meta" }
  ],
  "headers": [
    {
      "source": "/((?!shop|orders|collectibles|vault|explore|quests|timeline|projects|report|hackatime|fonts|img|pixl|show-n-tell).*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=15552000; includeSubDomains" }
      ]
    }
  ]
}
