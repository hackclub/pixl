SUPABASE_URL=
SUPABASE_SERVICE_KEY=

JWT_SECRET=change-this-to-a-long-random-string

PII_ENCRYPTION_KEY=

HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
HCA_REDIRECT_URI=http://localhost:3000/auth/hackclub/callback

PORT=3000

ADMIN_API_KEY=

# pixo-dm service (Slack DM proxy + avatar pixelator). Both must be set or
# the DM/pixify features fail closed (silently no-op / 503) rather than
# falling back to a hardcoded domain.
EXTERNAL_API_KEY=
EXTERNAL_DM_URL=
EXTERNAL_PIXIFY_URL=

# Same bot as apps/dashboard's SLACK_BOT_TOKEN. Used to ping REPORT_SLACK_CHANNEL
# when a new player report comes in (src/reports.ts postReportToSlack). Both must
# be set or the alert silently no-ops.
SLACK_BOT_TOKEN=
REPORT_SLACK_CHANNEL=

# Also used by src/shipNotify.ts postShipToSlack, which posts a rich preview
# (title/image/description/hours/author) whenever a project ships or re-ships.
# Optional , defaults to the team's ship-alerts channel if unset. Requires
# SLACK_BOT_TOKEN above; silently no-ops without it.
SHIP_SLACK_CHANNEL=

ALLOW_DEMO_LOGIN

# Login only redirects back to the hosts in ALLOWED_REDIRECT_HOSTS (auth.ts).
# Set this to true locally so a web export on localhost can finish logging in,
# never on a public server.
ALLOW_LOCAL_REDIRECT=true
# Extra hosts allowed as a login redirect target, comma separated (preview
# deploys and the like). https only.
WEB_REDIRECT_HOSTS=