# Orchard Postgres (same database as apps/server)
DATABASE_URL=

# AES-256-GCM key for decrypting birthday/mailing-address PII (lib/crypto.ts).
# Must match apps/server's PII_ENCRYPTION_KEY exactly.
# Generate with: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Hack Club Auth (https://auth.hackclub.com):
#  - Create an OAuth app at https://auth.hackclub.com/apps
#  - Redirect URI: <BASE_URL>/api/auth/callback
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Slack bot token (for API calls like DMs, avatars, etc.):
#  - https://api.slack.com/apps -> OAuth & Permissions -> Bot User OAuth Token
#  - Bot Token Scopes: chat:write, im:write, channels:history, channels:read
SLACK_BOT_TOKEN=xoxb-...

# Slack help channel ID (where tickets are posted)
SLACK_HELP_CHANNEL=

# Comma-separated Slack member IDs of the owners (e.g. U0123ABC,U0456DEF).
# Owners can do everything, including managing reviewers, helpers and
# fulfillers. This env var is the ONLY way to become an owner: there is no
# table for it, so nothing in the dashboard or the database can grant it.
ADMIN_SLACK_IDS=

# Comma-separated Slack member IDs allowed to do the FINAL (second) review pass.
# Only these reviewers can approve and credit pixels. If left empty, only owners
# (ADMIN_SLACK_IDS) qualify.
SECOND_PASS_SLACK_IDS=

# Player-facing DMs (review results, shop order updates, warns, bans, shipping
# tracking, notices - everything dmUser()/dmOrEmail() send), ticket resolves,
# review-channel posts and shop notifications all go through Pixo
# (apps/pixorpheus) so players see one identity. They default to Pixo's
# in-cluster address (http://pixl-pixorpheus.ysws-pixl.svc.cluster.local:3000,
# see lib/pixo.ts); leave the URLs blank on Orchard. EXTERNAL_API_KEY must match
# Pixo's. Without it, DMs and ticket resolves fall back to the dashboard's own
# Slack bot (SLACK_BOT_TOKEN).
EXTERNAL_API_KEY=
PIXORPHEUS_URL=
EXTERNAL_DM_URL=
EXTERNAL_TICKETS_URL=

# Email fallback (Resend) , used when a player has no slack_id or the DM fails.
# Leave empty to disable. Both must be set or nothing is emailed; EMAIL_FROM
# has no default and must be an address on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Long random string for signing session cookies
SESSION_SECRET=

# Where this dashboard runs (used for the Hack Club Auth redirect)
BASE_URL=http://localhost:4900

# Server admin API (/api/admin/*: Online tab, kick, image uploads, Blackout
# evidence refresh). Sent as the x-pixl-service-key header; must match
# SERVICE_KEY_INTERNAL_DASHBOARD in the server's env. Leave empty to disable
# those features (image uploads then fail with "Image upload disabled").
PIXL_SERVER_URL=
SERVICE_KEY_INTERNAL_DASHBOARD=

# Daily review-queue Slack alert (app/api/cron/queue-health). Channel ID the dashboard
# bot is invited to; leave empty to disable.
REVIEW_ALERT_CHANNEL=

# REQUIRED by cron endpoints; they fail closed (500) if this is unset.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Public Ships archive override for local tests only (must be HTTPS, except
# localhost). Fulfillment pages read the durable snapshot and never fetch this
# endpoint directly. The GitHub Actions schedule calls /api/cron/ships-snapshot
# every 10 minutes; add repository secret SHIPS_SNAPSHOT_CRON_SECRET with the
# same value as CRON_SECRET to enable it.
SHIPS_API_URL=
SHIPS_CACHE_TTL_MS=300000
# Rollout gate: leave false until the migration is applied and a complete
# Ships snapshot has been seeded by /api/cron/ships-snapshot.
SHIPS_SNAPSHOT_READER_ENABLED=false

# Robert fraud review (telescreen.hackclub.com) - the fraud determination
# now, no more human fraud triage (see 0206_robert_fraud_review.sql). Unset
# ROBERT_API_KEY to pause there: every first-pass-approved project just sits
# un-actionable in fraud_review (visible read-only on the Second pass tab)
# until a key is set, rather than falling back to any manual flow.
ROBERT_API_BASE=https://telescreen.hackclub.com/api/v1/ysws
ROBERT_API_KEY=
ROBERT_WEBHOOK_SECRET=
# One-time per environment, once /api/robert/outcome is deployed - Robert has
# no per-event PATCH endpoint for this, set it in Robert's own UI instead:
# the event's Settings -> Outcome webhook -> https://dash.pixl.hackclub.com/api/robert/outcome
# Robert issues the whsec_ signing secret there - put it in ROBERT_WEBHOOK_SECRET above.

# GitHub PAT used when fetching a project's commit history (lib/github.ts,
# review queue's Commits tab). Optional , without it those calls run
# unauthenticated and hit GitHub's 60/hr rate limit fast. A fine-grained token
# scoped to "Public Repositories (read-only)" is enough , no extra permissions
# needed since it only reads public commit data:
#  - https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Fraudy API key (fraudy.hackclub.com, API keys page). Optional: on the final
# pass the review page shows Fraudy's human/AI split and recommended deflation
# for each linked Hackatime project (lib/fraudy.ts). The key needs the
# check-ai endpoint allowed by the Fraudy superadmin. Without it only the
# "is it ai?" links show. Store it on Orchard with secret: true.
FRAUDY_API_KEY=

# Same idea, for a self-hosted Forgejo/Gitea or GitLab instance - optional,
# only useful for a private instance or a tighter rate limit. FORGEJO_TOKEN/
# GITLAB_TOKEN are ONLY ever sent to the exact host named here (see
# lib/commits.ts's trustedTokenHost) - a project's repo_url can point
# anywhere, so without this the token would go to whatever public host a
# project happens to name. Bare hostname means port 443; a non-default port
# must be written out (git.example.com:3000). Requests are https only.
FORGEJO_HOST=
FORGEJO_TOKEN=
GITLAB_HOST=
GITLAB_TOKEN=

# Airtable PAT for the intermediate "YSWS Project Submission" staging base
# (app80yzut0bdMNdHJ) - reviewers push approved projects here by hand from a
# project's page; a teammate then manually forwards each record into Hack
# Club's real Unified YSWS database from inside Airtable itself. Needs
# data.records:read/write + schema.bases:read scope, access limited to just
# that one base:
#  - https://airtable.com/create/tokens
AIRTABLE_PIXL_YSWS_UNIFIED_TOKEN=
