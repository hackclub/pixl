{
  "name": "@pixl/pixl",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.10.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "landing": "turbo dev --filter=@pixl/landing",
    "dashboard": "turbo dev --filter=@pixl/dashboard",
    "web-shell": "turbo dev --filter=@pixl/web-shell",
    "build": "turbo build",
    "config:sync": "bun run packages/config/sync.ts",
    "theme:sync": "bun run packages/theme/sync.ts",
    "docs:build": "bun run packages/docs-engine/build.ts",
    "previews:build": "bun run packages/docs-engine/build-previews.ts",
    "map:sync": "bun run packages/map-sync/sync.ts",
    "npcs:bake": "bun run apps/server/src/scripts/bake-npcs.ts"
  },
  "packageManager": "bun@1.3.13"
}
