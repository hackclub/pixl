{
  "name": "@pixl/pixl",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.11.9"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "internal-dashboard": "turbo dev --filter=@pixl/internal-dashboard",
    "pixl-dashboard": "turbo dev --filter=@pixl/pixl-dashboard",
    "build": "turbo build",
    "config:sync": "bun run packages/config/sync.ts",
    "theme:sync": "bun run packages/theme/sync.ts",
    "docs:build": "bun run packages/docs-engine/build.ts",
    "previews:build": "bun run packages/docs-engine/build-previews.ts",
    "map:sync": "bun run packages/map-sync/sync.ts",
    "npcs:bake": "bun run apps/server/src/scripts/bake-npcs.ts"
  },
  "packageManager": "bun@1.3.13",
  "overrides": {
    "esbuild": "0.28.2"
  }
}
